{
  "name": "listoria",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && pnpm --filter listoria-frontend build",
    "lint": "pnpm --filter listoria-frontend lint",
    "test:ai": "tsx --tsconfig frontend/tsconfig.json --test frontend/lib/ai/*.test.ts",
    "typecheck": "pnpm --filter listoria-frontend typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "admin:promote": "node --env-file=.env --experimental-strip-types prisma/promote-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.10.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "next": "15.5.18",
    "tsx": "^4.23.1"
  }
}
